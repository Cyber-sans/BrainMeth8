# Local deployment overrides for cropduster.
# This file is safe to copy to .env; .env itself is ignored by Git.

TZ=Europe/London

PROD_DATA_DIR=/srv/minecraft/brainmeth/prod
TEST_DATA_DIR=/srv/minecraft/brainmeth/test
BACKUP_DIR=/mnt/Backup3TB/minecraft/brainmeth/backups

PROD_MEMORY=6G
TEST_MEMORY=3G

MC_PORT_PROD=25577
VOICE_PORT_PROD=25576
MC_PORT_TEST=25575
VOICE_PORT_TEST=25574

MAX_PLAYERS=12
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MOTD=Brainmeth

# Warnings begin at 04:50; backup starts around 05:00.
BACKUP_CRON="50 4 * * *"
BACKUP_KEEP_COUNT=28
