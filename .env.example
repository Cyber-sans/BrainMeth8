# Local deployment overrides for cropduster.
# This file is safe to copy to .env; .env itself is ignored by Git.

TZ=Europe/London

PROD_DATA_DIR=/srv/minecraft/brainmeth/prod-1211
TEST_DATA_DIR=/srv/minecraft/brainmeth/test-1211
BACKUP_DIR=/mnt/Backup3TB/minecraft/brainmeth/backups-1211

PROD_MEMORY=6G
TEST_MEMORY=3G

MC_PORT_PROD=25587
VOICE_PORT_PROD=25586
MC_PORT_TEST=25585
VOICE_PORT_TEST=25584

MAX_PLAYERS=12
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MOTD=Brainmeth

# Warnings begin at 04:50; backup starts around 05:00.
BACKUP_CRON="50 4 * * *"
BACKUP_KEEP_COUNT=28
