// High-Speed Rail 0.9.0 for Minecraft 1.21.1 (classic minecart physics).
// 32 blocks/s maximum on straight rails = 4x vanilla. Curves stay at vanilla speed.
{
  "blocks": [
    {
      "blockId": "minecraft:redstone_block",
      "speedLimit": 8
    }
  ],
  "defaultSpeedLimit": 32,
  "isSpeedometerEnabled": false,
  "isTrueSpeedometerEnabled": false,
  "isIceBoatsEnabled": true
}
